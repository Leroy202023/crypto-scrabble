{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "mocha",
      "chai"
    ]
  },
  "include": [
    "tests/anchor/**/*.ts",
    "shared/**/*.ts",
    "target/types/*.ts"
  ]
}