{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "bot/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/anchor"
  ]
}